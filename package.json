{
  "name": "magpie-quwork",
  "version": "0.5.4",
  "description": "QuWork（qurvis）provider plugin for magpie：手机号/浏览器登录、模型代理、积分卡片、邀请码与权益面板",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "server.mjs",
    "src",
    "page",
    "README.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "quwork",
    "qurvis",
    "provider",
    "auth"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "panel": "node server.mjs"
  },
  "magpie": {
    "name": "QuWork",
    "maxConcurrency": 4,
    "summary": {
      "en": "QuWork (qurvis): multi-account console (credits, invite codes, check-in, WeChat binding), OpenAI-compatible model proxy, two sign-in paths.",
      "zh": "QuWork（qurvis）：多账号表格面板（积分 / 邀请码 / 签到 / 微信绑定）、OpenAI 兼容模型代理、两种登录方式。"
    },
    "page": {
      "title": "QuWork 面板",
      "titles": {
        "zh": "QuWork 面板",
        "zh-TW": "QuWork 面板"
      },
      "file": "page/gateway.html",
      "service": {
        "port": 4392,
        "option": "port"
      }
    },
    "options": {
      "baseUrl": "https://llm.quwork.cn/v1",
      "platformBaseUrl": "https://llm.rrzu.com",
      "port": 4392
    }
  }
}
